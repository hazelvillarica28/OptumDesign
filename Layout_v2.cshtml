<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ICBA Explorer</title>

    <meta name="description"
          content="Bright Ideas Explorer - Leadership Analytics Workspace" />

    @* Fonts used by the theme: Plus Jakarta Sans (UI) + Caveat (tagline) *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Caveat:wght@500;600&display=swap"
          rel="stylesheet" />

    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body>

    <div class="app">

        <aside class="sidebar">
            <a asp-page="/Index" class="brand-logo">ICBA <span>Explorer</span></a>

            @{
                var currentPage = (ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty)
                .Trim()
                .ToLowerInvariant();

                var activeMenu = (ViewData["ActiveMenu"]?.ToString() ?? string.Empty)
                .Trim()
                .ToLowerInvariant();

                bool IsActive(string pageRoute, string menuKey)
                {
                    var route = pageRoute.Trim().ToLowerInvariant();
                    var key = menuKey.Trim().ToLowerInvariant();
                    return currentPage == route || activeMenu == key;
                }
            }

            <nav class="nav">
                <a asp-page="/Index" class="nav-item @(IsActive("/index", "LeadershipCockpit") ? "active" : "")">
                    <img src="~/images/icons/leadership-cockpit.svg" class="ico" />
                    <span>Leadership Cockpit</span>
                </a>

                <a asp-page="/StrategicPortfolio" class="nav-item @(IsActive("/strategicportfolio", "StrategicPortfolio") ? "active" : "")">
                    <img src="~/images/icons/strategic-portfolio.svg" class="ico" />
                    <span>Strategic Portfolio</span>
                </a>

                <a asp-page="/GovernanceFlow" class="nav-item @(IsActive("/governanceflow", "GovernanceFlow") ? "active" : "")">
                    <img src="~/images/icons/governance-flow.svg" class="ico" />
                    <span>Governance Flow</span>
                </a>

                <a asp-page="/ImplementationScale" class="nav-item @(IsActive("/implementationscale", "ImplementationScale") ? "active" : "")">
                    <img src="~/images/icons/implementation-scale.svg" class="ico" />
                    <span>Implementation &amp; Scale</span>
                </a>

                <a asp-page="/ValueRealization" class="nav-item @(IsActive("/valuerealization", "ValueRealization") ? "active" : "")">
                    <img src="~/images/icons/value-realization.svg" class="ico" />
                    <span>Value Realization</span>
                </a>

                <a asp-page="/IdeatorDemographics" class="nav-item @(IsActive("/ideatordemographics", "IdeatorDemographics") ? "active" : "")">
                    <img src="~/images/icons/ideator-demographics.svg" class="ico" />
                    <span>Ideator Demographics</span>
                </a>

                <a asp-page="/DataConfidence" class="nav-item @(IsActive("/dataconfidence", "DataConfidence") ? "active" : "")">
                    <img src="~/images/icons/data-confidence.svg" class="ico" />
                    <span>Data Confidence</span>
                </a>

                <a asp-page="/RecordExplorer" class="nav-item @(IsActive("/recordexplorer", "RecordExplorer") ? "active" : "")">
                    <img src="~/images/icons/record-explorer.svg" class="ico" />
                    <span>Record Explorer</span>
                </a>
            </nav>

            <ul class="pillars">
                <li>PEOPLE</li>
                <li>IDEAS</li>
                <li>SOLUTIONS</li>
                <li class="is-on">BETTER CARE</li>
            </ul>
        </aside>

        <main class="main">
            <header class="topbar">
                <div class="tagline">A Healthier World Together</div>

                <div class="user-chip">
                    <img src="~/images/hazel.jpg" alt="Hazel Villarica" />
                    <div>
                        <b>Hazel Villarica</b>
                        <small>Software Engineer</small>
                    </div>
                    <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </div>
            </header>

            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/chart.umd.min.js"></script>
    <script src="~/lib/jquery/dist/xlsx.full.min.js"></script>
    <script src="~/lib/jquery/dist/html2canvas.min.js"></script>
    <script src="~/lib/jquery/dist/jspdf.umd.min.js"></script>
    <script src="~/lib/jquery/dist/pptxgen.bundle.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/dev/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>

</html>
